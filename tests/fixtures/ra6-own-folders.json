    {
      "name": "agent-hook-cleanup",
      "lang": "js",
      "text": "const fs=require('fs'); const {join}=require('path'); const {homedir}=require('os');\nasync function uninstall(){await fs.rm(join(homedir(),'.abs','hooks','claude-code'),{recursive:true,force:true});}\nuninstall();",
      "found": false
    },
    {
      "name": "owned-skill-and-version-cleanup",
      "lang": "js",
      "text": "const {rmSync}=require('fs'); const {join}=require('path'); const {homedir}=require('os');\nconst overridePath=join(homedir(),'.tool','overrides','example.json');\nconst skillPath=join(homedir(),'.cursor','skills','muggle');\nconst targetSkillDirectoryPath=join(homedir(),'.tool','skills','example');\nconst staleVersionDir=join(homedir(),'.tool','versions','1.2.3');\nrmSync(overridePath);rmSync(skillPath,{recursive:true});rmSync(targetSkillDirectoryPath,{recursive:true});rmSync(staleVersionDir,{recursive:true});",
      "found": false
    },
    {
      "name": "launch-agent-cleanup",
      "lang": "js",
      "text": "const {unlinkSync}=require('fs'); const {join}=require('path'); const {homedir,hostname}=require('os');\nconst PLIST_DIR=join(homedir(),'Library','LaunchAgents');\nconst PLIST_PATH=join(PLIST_DIR,'example.tool.plist');\nfetch('http://localhost:4000/internal/update-control',{method:'POST',body:hostname()});\n// local cleanup follows the unrelated request\nunlinkSync(PLIST_PATH);\n",
      "found": false
    },
    {
      "name": "deletion-line-after-local-fetch",
      "lang": "js",
      "text": "const {unlinkSync}=require('fs'); const {join}=require('path'); const {homedir,hostname}=require('os');\nconst PLIST_DIR=join(homedir(),'.ssh');\nconst PLIST_PATH=join(PLIST_DIR,'example-key');\nfetch('http://localhost:4000/internal/update-control',{method:'POST',body:hostname()});\n// local cleanup follows the unrelated request\nunlinkSync(PLIST_PATH);\n",
      "found": true,
      "line": 6
    },
    {
      "name": "deletion-line-before-local-fetch",
      "lang": "js",
      "text": "const fs=require('fs');\nfs.unlinkSync('/home/example/.ssh/example-key');\nfetch('http://localhost:4000/update',{method:'POST',body:require('os').hostname()});",
      "found": true,
      "line": 2
    },
    {
      "name": "python-deletion-line",
