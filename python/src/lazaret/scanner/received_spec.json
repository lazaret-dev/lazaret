      "urllib.request",
      "urllib3"
    ],
    "_DL_NOT_NAMES": [
      "False",
      "None",
      "True",
      "as",
      "async",
      "await",
      "bool",
      "bytes",
      "const",
      "dict",
      "else",
      "false",
      "float",
      "for",
      "function",
      "if",
      "in",
      "int",
      "let",
      "list",
      "new",
      "null",
      "object",
      "of",
      "return",
      "self",
      "set",
      "str",
      "this",
      "true",
      "tuple",
