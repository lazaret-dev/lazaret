  },
  "charstrings": {
    "_DL_PREFIX_CHARS": "BFRUbfru",
    "_DL_CALLEE_CHARS": "$.0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"
  },
  "limits": {
    "_DL_LONG_ROW": 1000,
    "_DL_WINDOW": 50,
    "_DL_ARG_SPAN": 400,
    "_DL_LOOKBACK": 450,
    "_DL_NAMED_SEARCHES": 64,
    "_DL_PHASES": 8,
    "_DL_ALIAS_MAX": 64,
    "_DL_JOIN_ROWS": 12,
    "_DL_JOIN_CHARS": 600,
    "_DL_LOGICAL_MAX_CHARS": 1000000
  },
  "patterns": {
    "_DL_MODULE_VALUE_RE": {
      "src": "\\s*(?:await\\s+)?(?:require|import)\\(\\s*[\"'](?:node:)?(?:https?|net|tls|axios|got|node-fetch|undici|ws)[\"']\\s*\\)\\s*(?:;\\s*)?$",
      "flags": "",
      "note": "a name bound to a network module (const https = require('https'))"
    },
    "_DL_FUNCTION_VALUE_RE": {
      "src": "\\s*(?:async\\s*)?(?:function\\b|\\([^()]{0,200}\\)\\s*=>|[A-Za-z_$][\\w$]*\\s*=>)",
      "flags": "",
      "note": "a name bound to a function value (const load = (u) => fetch(u))"
    },
    "_DL_IMPORT_RE": {
      "src": "^[ \\t]*import[ \\t]+(?P<py>[\\w.,]+(?:[ \\t]+[\\w.,]+)*)[ \\t]*$|^[ \\t]*from[ \\t]+(?:requests|httpx|urllib\\.request|socket)[ \\t]+import[ \\t]+(?:\\([ \\t]*)?(?P<pyfrom>[\\w,]+(?:[ \\t]+[\\w,]+)*)[ \\t]*\\)?[ \\t]*$|\\bimport\\s+(?:\\*\\s+as\\s+)?(?P<es>[A-Za-z_$][\\w$]*)\\s+from\\s+[\"'](?:node:)?(?:https?|net|tls|axios|got|node-fetch|undici|ws)[\"']|\\bimport\\s*\\{(?P<esn>[^{}]{0,200})\\}\\s*from\\s+[\"'](?:node:)?(?:https?|net|tls|axios|got|node-fetch|undici|ws)[\"']",
      "flags": "",
      "note": "network modules imported under a name (import requests as rq)"
    },
    "_DL_CHAIN_RE": {
      "src": "(?<![\\w$.])[A-Za-z_$][\\w$]*(?:\\s*\\??\\.\\s*[A-Za-z_$][\\w$]*){0,50}",
      "flags": "",
      "note": "a member chain (r, r.text, a.b.c)"
    },
    "_DL_HEAD_RE": {
      "src": "(?<![\\w$.])[A-Za-z_$][\\w$]*",
      "flags": "",
      "note": "a chain's first name"
    },
    "_DL_WORD_RUN_RE": {
      "src": "[\\w$]+",
      "flags": "",
      "note": "a run of word characters (a name, for the names index)"
    },
    "_DL_STR_RE": {
      "src": "\\\"(?:\\\\.|[^\\\"\\\\])*\\\"|'(?:\\\\.|[^'\\\\])*'|`(?:\\\\.|[^`\\\\])*`",
      "flags": "",
      "note": "a string literal (single, double or template)"
    },
    "_DL_TEMPLATE_HOLE_RE": {
      "src": "\\$\\{([^{}]*)\\}",
      "flags": "",
      "note": "a template literal's ${...} interpolation"
    },
    "_DL_FSTRING_HOLE_RE": {
      "src": "(?<!\\{)\\{([^{}]*)\\}",
      "flags": "",
      "note": "an f-string's {...} interpolation"
    },
    "_DL_BIND_RE": {
      "src": "(?P<ann>(?<![\\w$.])[A-Za-z_$][\\w$]*)\\s*:\\s*[\\w$.\\[\\], |]{1,80}?\\s*=(?![=>])|(?P<lhs>(?<![\\w$.])[A-Za-z_$][\\w$]*(?:\\s*\\.\\s*[A-Za-z_$][\\w$]*){0,8}(?:\\s*,\\s*[A-Za-z_$][\\w$]*){0,8}|\\{[^{}()=;]{0,200}\\}|\\[[^\\[\\]()=;]{0,200}\\])\\s*(?:\\+|\\|\\||\\?\\?)?=(?![=>])|\\bas\\s+(?P<with>[A-Za-z_]\\w*)\\s*[:,)]|\\bfor\\s*(?:\\(\\s*)?(?:(?:const|let|var)\\s+)?(?P<for>[A-Za-z_$][\\w$]*(?:\\s*,\\s*[A-Za-z_$][\\w$]*){0,8}|\\{[^{}]{0,200}\\}|\\[[^\\[\\]]{0,200}\\])\\s+(?:of|in)\\b|\\breturn\\b(?P<ret>)",
      "flags": "",
      "note": "what a row binds: assignment, with-as, for, return"
    },
    "_DL_PARAMS_RE": {
      "src": "\\bfunction\\b\\s*(?:[\\w$]+\\s*)?\\((?P<fp>[^()]{0,200})\\)|\\((?P<ap>[^()]{0,200})\\)\\s*=>|(?<![\\w$.])(?P<one>[A-Za-z_$][\\w$]*)\\s*=>|\\blambda\\b(?P<lp>[^:()]{0,200}):",
      "flags": "",
      "note": "a function's parameters (function (res) {, (res) =>, lambda res:)"
    },
    "_DL_FN_HEADER_RE": {
      "src": "^\\s*(?:async\\s+)?def\\s+(?P<py>\\w+)|\\bfunction\\s*(?:\\*\\s*)?(?P<js>[A-Za-z_$][\\w$]*)\\s*\\(|\\b(?:const|let|var)\\s+(?P<var>[A-Za-z_$][\\w$]*)\\s*=\\s*(?:async\\s*)?(?:function\\b|\\([^()]{0,200}\\)\\s*=>|[A-Za-z_$][\\w$]*\\s*=>)",
      "flags": "",
      "note": "a function header (def name, function name, const name = ...)"
    },
    "_DL_NAME_RE": {
      "src": "[A-Za-z_$][\\w$]*",
      "flags": "",
      "note": "an identifier"
    },
    "_DL_DEFAULT_RE": {
      "src": "=[^,]*",
      "flags": "",
      "note": "a parameter default (=... up to a comma)"
    },
    "_DL_DOT_RE": {
      "src": "\\s*\\??\\.\\s*",
      "flags": "",
      "note": "a member-access dot with optional chaining/space"
    },
    "_DL_SHELL_TRUE_RE": {
      "src": "\\bshell\\s*=\\s*True\\b",
      "flags": "",
      "note": "shell=True anywhere"
    },
    "_DL_SHELL_CALL_RE": {
      "src": "(?:run|call|Popen|check_output|check_call)\\s*\\(",
      "flags": "",
      "note": "a subprocess run-family call (needs shell=True to fire)"
    },
    "_DL_SHELL_ARG_RE": {
      "src": "shell(?<!\\wshell)\\s*=\\s*True",
      "flags": "",
      "note": "a shell=True argument (first 'shell', then a boundary)"
    },
    "_DL_BRACKET_RE": {
      "src": "[()\\[\\]{},]",
      "flags": "",
      "note": "any bracket or comma (for the one-pass bracket match)"
    },
    "_DL_EMBED_RE": {
      "src": "\\s*[rRbBuUfF]{0,2}[\"'`]\\s*(?:[\\w.:~-]*[/\\\\]){0,8}(?:node|nodejs|bun|python[\\d.]*|pythonw|(?:ba|z|da|k)?sh|perl|ruby|php|pwsh|powershell|osascript|cmd)(?:\\.exe)?(?:\\s+-[\\w-]+){0,6}?\\s+(?:-(?:e|E|c|p|r|-eval|-print|Command|command|EncodedCommand|enc)|/[cCkK])\\b",
      "flags": "",
      "note": "an interpreter with an inline-code flag written into a command line"
    },
    "_DL_LEAD_RE": {
      "src": "\\s*(?:(?:await|yield)\\s+|\\(\\s*){0,50}",
      "flags": "",
      "note": "leading whitespace, await/yield and open parens before a value"
    },
    "_DL_CALLEE_RE": {
      "src": "(?:new\\s+)?(?P<chain>[A-Za-z_$][\\w$]*(?:\\s*\\??\\.\\s*[A-Za-z_$][\\w$]*){0,50})\\s*(?P<call>\\()?",
      "flags": "",
      "note": "a callee chain, optionally called"
    },
    "_DL_ALIAS_RE": {
      "src": "(?<![\\w$.])(?P<alias>[A-Za-z_$][\\w$]*)\\s*=(?![=>])\\s*(?:new\\s+)?(?:require\\(\\s*[\"'](?:node:)?child_process[\"']\\s*\\)\\s*\\.\\s*execSync|require\\(\\s*[\"'](?:node:)?child_process[\"']\\s*\\)\\s*\\.\\s*exec|(?:child_process|childProcess|cp)\\s*\\.\\s*execSync|(?:child_process|childProcess|cp)\\s*\\.\\s*exec|(?:window|globalThis|global|self)\\s*\\.\\s*eval|vm\\s*\\.\\s*runInThisContext|(?:os|subprocess)\\s*\\.\\s*(?:system|popen|getstatusoutput|getoutput)|execSync|execfile|exec|eval|compileFunction|getstatusoutput|getoutput|Function)\\s*(?![\\w$.(\\[])",
      "flags": "",
      "note": "a runner-alias definition (name = a direct code-runner reference)"
    },
    "_DL_FILE_WRITE_RE": {
      "src": "\\b(?:fs\\s*\\.\\s*)?(?:write|append)File(?:Sync)?\\s*\\(\\s*(?P<p1>[A-Za-z_$][\\w$]*|[\"'][^\"'\\n]{1,200}[\"'])\\s*,|\\bcreateWriteStream\\s*\\(\\s*(?P<p2>[A-Za-z_$][\\w$]*|[\"'][^\"'\\n]{1,200}[\"'])|\\bopen\\s*\\(\\s*(?P<p3>[A-Za-z_$][\\w$]*|[\"'][^\"'\\n]{1,200}[\"'])\\s*,[^)\\n]{0,60}?[\"'][rbtU]*[wax]\\+?[rbtU]*[\"']|\\burlretrieve\\s*\\(\\s*[^,()\\n]{1,300},\\s*(?P<p4>[A-Za-z_$][\\w$]*|[\"'][^\"'\\n]{1,200}[\"'])\\s*\\)",
      "flags": "",
      "note": "a received value written to a file, naming the path"
    },
    "_DL_PATHRUN_SINK_RE": {
      "src": "\\b(?:os\\.system|os\\.startfile|runpy\\.run_path)\\s*\\(|\\b(?:subprocess\\s*\\.\\s*)?(?:run|Popen|call|check_call|check_output)\\s*\\(|\\b(?:spawn|spawnSync|execFile|execFileSync|fork)\\s*\\(|(?<![\\w$.])(?:require|import|execfile)\\s*\\(|(?<![\\w$.])exec\\s*\\(\\s*open\\s*\\(",
      "flags": "",
      "note": "the opener of a call that runs a path"
    },
    "_DL_FROM_IMPORT_RE": {
      "src": "^[ \\t]*from[ \\t]+[\\w.]+[ \\t]+import\\b",
      "flags": "",
      "note": "a Python from-import line (excludes the import() sink)"
    },
    "_DL_BARE_IMPORT_RE": {
      "src": "import\\s*\\(",
      "flags": "",
      "note": "the bare import( dynamic-import sink"
    },
    "_DL_JOIN_CHAIN_RE": {
      "src": "[ \\t]*\\??\\.[ \\t]*[A-Za-z_$]",
      "flags": "",
      "note": "a row that continues a member chain from the row above (.then(...), ?.post(...)), not a spread or a number"
    },
    "_DL_JOIN_COMMENT_RE": {
      "src": "(?:^|(?<=[ \\t]))(?://|#(?![\\w$]))",
      "flags": "",
      "note": "a trailing comment, once string contents are blanked (// or #, after a space or at the start)"
    },
    "_DL_JOIN_BLOCK_RE": {
      "src": "=>|\\bfunction\\b|\\blambda\\b|\\bdef\\b|\\bclass\\b",
      "flags": "",
      "note": "a row that opens a function or a class, whose body is never joined into a statement"
    },
    "_DL_ENV_PY_RE": {
      "src": "\\b(?:os[ \\t]*\\.[ \\t]*)?(?:environ[ \\t]*\\[[ \\t]*['\"](?P<a>[A-Za-z_][A-Za-z0-9_]{0,63})['\"][ \\t]*\\]|environ[ \\t]*\\.[ \\t]*get[ \\t]*\\([ \\t]*['\"](?P<b>[A-Za-z_][A-Za-z0-9_]{0,63})['\"][ \\t]*(?:,[^()\\n]{0,120})?\\)|getenv[ \\t]*\\([ \\t]*['\"](?P<c>[A-Za-z_][A-Za-z0-9_]{0,63})['\"][ \\t]*(?:,[^()\\n]{0,120})?\\))",
      "flags": "",
      "note": "a Python environment variable read or written by name (os.environ['X'], os.environ.get('X'), os.getenv('X')), read as environ.X"
    },
    "_DL_ENV_JS_RE": {
      "src": "\\bprocess[ \\t]*\\.[ \\t]*env[ \\t]*\\[[ \\t]*['\"`](?P<a>[A-Za-z_$][A-Za-z0-9_$]{0,63})['\"`][ \\t]*\\]",
      "flags": "",
      "note": "a JavaScript environment variable by name in brackets (process.env['X']), read as process.env.X"
    },
    "_DL_COMMA_CALL_RE": {
      "src": "\\(\\s*0\\s*,\\s*(?P<c>[A-Za-z_$][\\w$]*(?:[ \\t]*\\.[ \\t]*[A-Za-z_$][\\w$]*){0,8})\\s*\\)(?=\\s*\\()",
      "flags": "",
      "note": "a call through a comma expression, (0, ns.fn)(...) as TypeScript and Babel write an imported function's call: read as ns.fn(...)"
    },
    "_DL_GETATTR_RE": {
      "src": "\\bgetattr[ \\t]*\\([ \\t]*(?P<o>[A-Za-z_$][\\w$]*(?:[ \\t]*\\.[ \\t]*[A-Za-z_$][\\w$]*){0,8})[ \\t]*,[ \\t]*(?:'(?P<a>[A-Za-z_$][\\w$]{0,63})'|\"(?P<b>[A-Za-z_$][\\w$]{0,63})\")[ \\t]*(?:,[^()\\n]{0,120})?\\)",
      "flags": "",
      "note": "getattr(obj, 'name') (and a default), read as obj.name"
    },
    "_DL_MEMBER_RE": {
      "src": "(?<=[\\w$)\\]])\\[(?:'(?P<a>[A-Za-z_$][\\w$]{0,63})'|\"(?P<b>[A-Za-z_$][\\w$]{0,63})\")\\]",
      "flags": "",
      "note": "obj['name'] or obj[\"name\"], read as obj.name"
    },
    "_DL_CALLBACK_RE": {
      "src": "(?<=[(,])[ \\t]*(?P<r>eval|Function|execSync|exec|(?:vm[ \\t]*\\.[ \\t]*)?runIn(?:This|New)?Context)[ \\t]*(?=\\)(?![ \\t]*\\())",
      "flags": "",
      "note": "a code runner handed to a call as its last argument (p.then(eval), res.on('data', eval)), read as (_v)=>eval(_v)"
    }
  },
  "alternatives": {
    "_DL_SOURCE": {
      "pairs": [
        [
          "\\b",
          "urlopen\\s*\\("
        ],
