          "\\(\\s*(?:void\\s+)?[\\w$.]+\\s*,\\s*(?:(?:window|globalThis|self|global|top|parent|frames)\\s*\\.\\s*)?(?:eval|Function)\\s*\\)\\s*\\("
        ],
        [
          "\\b",
          "(?:eval|Function)\\s*\\.\\s*call\\s*\\("
        ],
        [
          "\\b",
          "(?:eval|Function)\\s*\\.\\s*bind\\s*\\([^()]*\\)\\s*\\("
        ],
        [
          "",
          "\\[\\s*['\\\"`](?:e(?:['\\\"`]\\s*\\+\\s*['\\\"`])?v(?:['\\\"`]\\s*\\+\\s*['\\\"`])?a(?:['\\\"`]\\s*\\+\\s*['\\\"`])?l|F(?:['\\\"`]\\s*\\+\\s*['\\\"`])?u(?:['\\\"`]\\s*\\+\\s*['\\\"`])?n(?:['\\\"`]\\s*\\+\\s*['\\\"`])?c(?:['\\\"`]\\s*\\+\\s*['\\\"`])?t(?:['\\\"`]\\s*\\+\\s*['\\\"`])?i(?:['\\\"`]\\s*\\+\\s*['\\\"`])?o(?:['\\\"`]\\s*\\+\\s*['\\\"`])?n)['\\\"`]\\s*\\]\\s*\\("
        ],
        [
          "(?<![\\w$.])",
          "(?:Function|Object|Array|String|Number|Boolean|Promise|Date|RegExp|Error|Symbol)\\s*\\.\\s*constructor\\s*\\("
        ],
        [
          "\\b",
          "constructor\\s*\\.\\s*constructor\\s*\\("
