      "note": "a call that runs its argument as code (eval/exec/Function/vm/child_process, indirect eval) A built-in's constructor is Function: Function.constructor(...), x.constructor.constructor(...) and [\"constructor\"][\"constructor\"](...) run their argument too (0.1.8)."
    },
    "_DL_RUNNER_SHELL": {
      "extends": "_DL_RUNNER",
      "pairs": [
        [
          "\\b",
          "(?:run|call|Popen|check_output|check_call)\\s*\\("
        ]
      ],
      "note": "the runners plus subprocess run-family calls (used when the file has shell=True)"
    },
    "_DL_DESERIAL": {
      "pairs": [
        [
          "\\b",
          "(?:pickle|cPickle|_pickle|dill|cloudpickle)\\.loads?\\s*\\("
        ],
        [
          "\\b",
          "marshal\\.loads?\\s*\\("
        ],
        [
          "\\b",
          "jsonpickle\\.decode\\s*\\("
        ],
        [
          "\\b",
          "yaml\\.load\\s*\\((?!(?:[^()]|\\([^()]*\\)){0,400}?(?:SafeLoader|safe_load))"
        ],
        [
          "\\b",
          "unserialize\\s*\\("
        ]
      ],
      "note": "a deserializer that runs code embedded in its argument (CWE-502)"
    },
    "_DL_IMPORT_SINK": {
      "pairs": [
        [
          "(?<![\\w$.])",
          "import\\s*\\("
        ],
        [
          "(?<![\\w$.])",
          "require\\s*\\("
        ],
        [
          "(?<![\\w$.])",
          "__import__\\s*\\("
        ],
        [
          "\\b",
          "importlib\\.import_module\\s*\\("
        ],
        [
          "(?<![\\w$.])",
          "import_module\\s*\\("
        ]
      ],
      "note": "a dynamic import of a received module specifier"
    },
    "_DL_INTERP": {
      "pairs": [
        [
          "",
          "[\"'`](?:[\\w.:~-]*[/\\\\]){0,8}(?:node|nodejs|bun|python[\\d.]*|pythonw|(?:ba|z|da|k)?sh|perl|ruby|php|pwsh|powershell|osascript|cmd)(?:\\.exe)?[\"'`]"
        ],
        [
          "\\b",
          "process\\.(?:execPath|argv\\[0\\])"
        ],
        [
          "\\b",
          "sys\\.executable"
        ]
      ],
      "tail": "\\s*,\\s*(?:\\[\\s*)?(?:[\"'`]-[^\"'`\\n]{0,40}[\"'`]\\s*,\\s*){0,4}?[\"'`](?:-(?:e|E|c|p|r|-eval|-print|Command|command|EncodedCommand|enc)|/[cCkK])[\"'`]\\s*,\\s*",
      "note": "an interpreter given inline code as argv ('node','-e',CODE)"
    }
  }
}
