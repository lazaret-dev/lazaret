{
  "name": "lazaret",
  "version": "0.1.8",
  "description": "Quarantine for your dependencies: supply-chain security for Python and JavaScript packages.",
  "type": "module",
  "bin": {
    "lazaret": "bin/lazaret.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin/",
    "src/",
    "native/lazaret.wasm",
    "native/NOTICE",
    "README.md",
    "LICENSE",
    "LICENSE-UNICODE",
    "NOTICE",
    "!**/.*",
    "!**/*.pem",
    "!**/*.key",
    "!**/id_rsa*",
    "!**/id_ed25519*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-wasm.js",
    "prepack": "node scripts/build-wasm.js --check",
    "test": "node --test"
  },
  "keywords": [
    "supply-chain",
    "security",
    "dependencies",
    "npm",
    "pypi",
    "typosquatting"
  ],
  "author": "John A. Booth",
  "license": "Apache-2.0 AND Unicode-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazaret-dev/lazaret.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://lazaret.dev",
  "bugs": {
    "url": "https://github.com/lazaret-dev/lazaret/issues"
  }
}
